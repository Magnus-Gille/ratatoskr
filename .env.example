TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
ANTHROPIC_API_KEY=
MUNIN_URL=http://localhost:3030
MUNIN_API_KEY=
PORT=3034
HOST=127.0.0.1
CONCIERGE_MODEL=claude-haiku-4-5-20251001
POLL_INTERVAL_MS=30000
MAX_POLL_DURATION_MS=7200000
RATATOSKR_CONSOLIDATION_POLL_MS=120000
RATATOSKR_INSTANCE_ID=default
REPOS_BASE_PATH=/home/magnus/repos

# --- Concierge rate limit (issue #3) ---
# Max concierge (Haiku) triage calls per chat per window; over the limit the bot
# replies a throttled "slow down" notice instead of calling the API.
RATATOSKR_CONCIERGE_RATE_LIMIT=8
RATATOSKR_CONCIERGE_RATE_WINDOW_MS=60000

# --- Heimdall alert-bus echo (issue #16) ---
# When BOTH are set, an `alert` posted to /api/send is best-effort echoed to
# Heimdall's fail-closed /api/alerts ingest. Either unset → echo skipped.
HEIMDALL_INGEST_URL=
HEIMDALL_ALERT_TOKEN=

# --- Authenticated remote send (see docs/remote-send.md) ---
# To let trusted tailnet hosts fire Telegram pings without SSH/on-box access,
# bind HOST to this Pi's Tailscale IP (`tailscale ip -4`) and set a strong key.
# Once RATATOSKR_SEND_API_KEY is set, the Bearer token is enforced on EVERY bind
# (loopback included), and a non-loopback bind without it disables the endpoint.
# Never use a wildcard bind (0.0.0.0/::): it exposes /api/send on the LAN where
# the token is sent in cleartext. Bind to the Tailscale IP only.
# Generate: openssl rand -hex 32 (hex/base64url only — no quotes/spaces/backslashes)
RATATOSKR_SEND_API_KEY=

# --- Hugin task submission signing (PR #5) ---
RATATOSKR_SIGNING_SECRET=
RATATOSKR_SIGNING_KEY_ID=ratatoskr
