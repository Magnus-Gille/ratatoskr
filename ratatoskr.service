[Unit]
Description=Ratatoskr Telegram Router
# tailscaled ordering matters when HOST is bound to the Pi's Tailscale IP for
# authenticated remote send (docs/remote-send.md): the tailnet address must be
# assigned before we listen on it. Ordering is best-effort — the bind race is
# handled in-process first (src/listen.ts retries EADDRNOTAVAIL ~60x/5min so a
# tailnet blip doesn't take the bot down), with Restart=always below as the
# backstop once that retry cap is exhausted.
After=network-online.target tailscaled.service munin-memory.service
Wants=network-online.target

[Service]
Type=simple
User=magnus
WorkingDirectory=/home/magnus/repos/ratatoskr
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
EnvironmentFile=/home/magnus/repos/ratatoskr/.env

ProtectSystem=strict
ReadWritePaths=/home/magnus /tmp
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
